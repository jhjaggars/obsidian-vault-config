# launchagents.env — Local secrets and overrides for the vault launchd agents.
#
# Copy this file to .claude/launchagents.env and fill in the required values.
# This file is gitignored — never commit launchagents.env.
#
# Run .claude/setup-launchagents.sh to install the agents after editing.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Jira API token (used by the daily-work-sync agent)
JIRA_API_TOKEN=your-token-here

# ---------------------------------------------------------------------------
# Optional overrides (sensible defaults are baked into setup-launchagents.sh)
# ---------------------------------------------------------------------------

# Colon-separated PATH for the launchd environment.
# Default: ~/.local/bin:~/go/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin
# AGENT_PATH=/custom/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin

# Vertex AI / Claude settings
# CLAUDE_CODE_USE_VERTEX=1
# ANTHROPIC_VERTEX_PROJECT_ID=itpc-gcp-hcm-pe-eng-claude
# GOOGLE_APPLICATION_CREDENTIALS=/Users/you/.config/gcloud/application_default_credentials.json

# Model name overrides
# ANTHROPIC_MODEL=opusplan
# ANTHROPIC_DEFAULT_SONNET_MODEL=claude-sonnet-4-6[1m]
# ANTHROPIC_DEFAULT_OPUS_MODEL=claude-opus-4-6
# ANTHROPIC_DEFAULT_HAIKU_MODEL=claude-haiku-4-6

# Daily sync pipeline model (default: claude-haiku-4-5)
# This controls which model the daily sync agents use.
# DAILY_SYNC_MODEL=claude-haiku-4-5

# Dossier synthesizer concurrency (default: 4)
# Each person is processed in parallel — safe because each writes to a separate file.
# DOSSIER_CONCURRENCY=4

# Metrics dashboard port (socket-activated; default: 9847)
# DASHBOARD_PORT=9847
